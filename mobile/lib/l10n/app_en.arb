  "minorAccountReviewWelcomePageTitle": "Family guide",
  "minorAccountReviewWelcomeTitle": "Not 16 yet? That's OK.",
  "minorAccountReviewWelcomeBody": "If you clicked through to this page instead of just picking the answer that got you in, that matters. It shows honesty, backbone, and real care for the people around you.\n\nRules for people under 16 vary depending on where you live. At Divine, we want families to talk it through together and decide what healthy social media use looks like.",
  "minorAccountReviewModerationTitle": "We need one more step",
  "minorAccountReviewModerationBody": "We were asked to take a closer look at this account because it may belong to someone under 16. This flow keeps the next steps private and points you to the right path for your age.",
  "minorAccountReviewRulesTitle": "The rules are not the same everywhere",
  "minorAccountReviewRulesBody": "Different countries and regions treat teen social media use differently. That is why we ask families to slow down, check the facts, and choose the next step together.",
  "minorAccountReviewApproachTitle": "How Divine thinks about it",
  "minorAccountReviewApproachBody": "We think healthy tech habits come from pausing, reflecting, and redirecting attention toward better things, not from spying on kids or turning parents into hall monitors. Research backs that up too.",
  "minorAccountReviewLearnMoreTitle": "More for families",
  "minorAccountReviewKidsPolicyCta": "Read Divine's kids policy",
  "minorAccountReviewChooseAgeBandTitle": "Choose the path that fits",
  "minorAccountReviewUnder13Cta": "Under 13",
  "minorAccountReviewTeenCta": "Age 13-15",
  "minorAccountReviewFamilyResourcesBody": "Visit the Divine family guide for practical tips, conversation tools, and resources for helping teens use social media more safely.",
  "minorAccountReviewFamilyResourcesCta": "Get family guides and tips",
  "minorAccountReviewFooter": "If you are 16 or older and got sent here by mistake, contact Divine support so a real person can review it.",
  "minorAccountReviewTitle": "Account Review",
  "minorAccountReviewCheckingStatusTitle": "Checking account status...",
  "minorAccountReviewCheckingStatusBody": "Please wait while we confirm this account's current review status.",
  "minorAccountReviewDefaultTitle": "Account review required",
