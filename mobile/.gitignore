# Tests
test*.mp4
# Golden failure diffs are debug output from a red run, never fixtures. The
# glob covers every test/ subtree because a screens-only, then goldens-only
# rule twice let 20 artifacts land in git from test/widgets/failures/.
test/**/failures/
packages/*/test/**/failures/
integration_test/test_bundle.dart
test/.test_optimizer.dart

# fastlane screenshot pipeline artifacts (generated per run)
ios/fastlane/report.xml
ios/fastlane/test_output/
ios/fastlane/screenshots/**/*.png
ios/fastlane/screenshots/**/*.html
ios/fastlane/README.md
ios/fastlane/DerivedData/
ios/fastlane/.venv/
