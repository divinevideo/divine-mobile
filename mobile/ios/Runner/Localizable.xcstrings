{
  "sourceLanguage": "en",
  "strings": {
    "divine_camera_intent_description": {
      "extractionState": "manual",
      "localizations": {
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የDivine ካሜራን ለመቅረጽ ዝግጁ አድርጎ ይከፍታል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح كاميرا Divine جاهزة للتسجيل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отваря камерата на Divine, готова за запис."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Divine-Kamera, bereit zur Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the Divine camera, ready to record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la cámara Divine, lista para grabar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan ang Divine camera, handa nang mag-record."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l'appareil photo Divine, prêt à filmer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka kamera Divine, siap merekam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la fotocamera Divine, pronta a registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Divineカメラを開き、すぐに録画できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Divine 카메라를 열어 바로 녹화할 수 있어요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka kamera Divine, sedia untuk merakam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de Divine-camera, klaar om op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera aparat Divine gotowy do nagrywania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a câmera Divine, pronta para gravar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide camera Divine, gata de filmare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar Divine-kameran, redo att spela in."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Divine కెమెరాను రికార్డింగ్‌కు సిద్ధంగా తెరుస్తుంది."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Divine kamerasını kayda hazır şekilde açar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Divine کیمرا ریکارڈنگ کے لیے تیار حالت میں کھولتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở camera Divine, sẵn sàng để quay."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Divine 相机，随时开始录制。"
          }
        }
      }
    },
