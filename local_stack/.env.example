# Generated by setup.sh (openssl rand -hex 32)
SERVER_NSEC=

# --- Optional: run a native invite image on Apple Silicon -------------------
#
# The published invite image is amd64-only, so Compose selects linux/amd64 and
# Docker Desktop runs it through emulation. If you build and tag the invite
# image locally on an arm64 Mac, select that native image instead.
# INVITE_PLATFORM=linux/arm64

# --- Optional: run against a locally built funnelcake ------------------------
#
# The default GHCR images track funnelcake main. Build locally when testing an
# unmerged funnelcake branch or when you need native arm64 images on Apple
# Silicon; the published images are currently linux/amd64 only.
#
#     bash local_stack/build_funnelcake.sh
#     # Add the printed override lines below to this file.
#     mise run local_reset
#
# Set all three together — the images share a schema, and mixing binary and
# migration versions can make API reads fail against incompatible column types.
#
# FUNNELCAKE_MIGRATE_IMAGE=funnelcake-migrate:local
# FUNNELCAKE_RELAY_IMAGE=funnelcake-relay:local
# FUNNELCAKE_API_IMAGE=funnelcake-api:local
#
# Locally built images are in no registry, so the default `always` pull policy
# would fail before the local image is considered.
# FUNNELCAKE_PULL_POLICY=never
#
# Where build_funnelcake.sh looks for the checkout (default: ../divine-funnelcake).
# DIVINE_FUNNELCAKE_ROOT=/path/to/divine-funnelcake
#
# Days before the staleness warning fires (default: 45).
# STACK_STALE_AFTER_DAYS=45

# Existing Funnelcake volumes upgrade automatically. If startup reports
# "Dirty database version", the interrupted local migration cannot resume;
# `mise run local_reset` deletes the disposable local data and starts clean.
