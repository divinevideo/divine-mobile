<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="video.divine.widgetlab">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
    <instrumentation android:name=".AndroidRenderingTests" android:targetPackage="video.divine.widgetlab" android:label="Widget rendering tests" />
    <application android:label="Divine Widget Lab" android:theme="@style/LabTheme" android:debuggable="true" android:allowBackup="false">
        <activity android:name=".LabActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".HighlightProvider" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/highlight_widget_info" />
        </receiver>
    </application>
</manifest>
